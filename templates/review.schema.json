{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/1404desk.review.v1.json",
  "title": "1404 Desk Review",
  "type": "object",
  "required": ["schema", "capturedAt", "address", "chainId", "community", "scan"],
  "properties": {
    "schema": { "const": "1404desk.review.v1" },
    "capturedAt": { "type": "string", "description": "ISO-8601 UTC" },
    "address": { "type": "string" },
    "label": { "type": "string" },
    "exchangeUid": { "type": "string" },
    "depositAddress": { "type": "string" },
    "txHash": { "type": "string" },
    "chainId": { "type": "integer" },
    "divergent": { "type": ["boolean", "null"] },
    "summary": { "type": "string" },
    "community": { "type": "object" },
    "scan": { "type": "object" },
    "traces": { "type": "array" }
  }
}
